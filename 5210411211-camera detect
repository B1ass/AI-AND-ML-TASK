import cv2
import time

camera = 0
deteksi = cv2.CascadeClassifier('haarcascade_frontalface_default.xml')
video =  cv2.VideoCapture(camera, cv2.CAP_DSHOW)

recognizer = cv2.face.LBPHFaceRecognizer_create()
recognizer.read('dataset/training.xml') 

a = 0
while True:
    a = a + 1
    check, frame = video.read()
    grayscale = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    muka = deteksi.detectMultiScale(grayscale, 1.3, 5)
    for (x, y, w, h) in muka:
        cv2.rectangle(frame, (x, y), (x+w, y+h), (0, 255, 0), 2)
        id, conf = recognizer.predict(grayscale[y:y+h, x:x+w])
        if id == 1:
            id = 'Rifqi'
        elif id ==2:
            id =""
        cv2.putText(frame, str(id), (x+40, y-10), cv2.FONT_HERSHEY_COMPLEX, 1, (0, 255, 0))
    cv2.imshow("face", frame)
    key = cv2.waitKey(1)
    if key == ord('a'):
        break

video.release()
cv2.destroyAllWindows()
